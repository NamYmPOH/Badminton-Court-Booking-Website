# ─────────────── Database ───────────────
DATABASE_URL="postgresql://smashbook:smashbook@localhost:5432/smashbook"
DIRECT_URL="postgresql://smashbook:smashbook@localhost:5432/smashbook"

# ─────────────── Redis ───────────────
REDIS_URL="redis://localhost:6379"

# ─────────────── Auth.js ───────────────
