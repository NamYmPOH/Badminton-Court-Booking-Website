# Copy file này thành .env. Chỉ điền khóa thật vào .env, không commit.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Thông tin quản lý; KHÔNG dùng tên/mã đơn vị làm bằng chứng thanh toán.
SEPAY_UNIT_NAME="San cau long cua ban"
SEPAY_UNIT_CODE="MA_DON_VI_CUA_BAN"

# Chọn đúng phương thức đã cấu hình tại Webhooks > Bảo mật.
SEPAY_AUTH_MODE=hmac
SEPAY_WEBHOOK_SECRET=
# Chỉ cần điền khi SEPAY_AUTH_MODE=apikey. Đây là key của webhook.
SEPAY_WEBHOOK_API_KEY=

# Số tài khoản phải giữ dạng chuỗi, kể cả khi bắt đầu bằng 0.
# Dưới đây là thông tin minh họa, PHẢI thay bằng tài khoản nhận của bạn.
BANK_BIN=970436
BANK_ACCOUNT_NO=0123456789
BANK_ACCOUNT_NAME="NGUYEN VAN A"
# Tên gateway theo payload SePay, không phải BIN VietQR.
SEPAY_BANK_GATEWAY=Vietcombank
# Để trống nếu không sử dụng tài khoản ảo (VA).
SEPAY_SUB_ACCOUNT=
