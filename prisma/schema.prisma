// SmashBook — Prisma Schema (§6.2)
// Xem thêm: badminton-booking-spec.md §6

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────── Enums ─────────────
enum Role {
  CUSTOMER
  STAFF
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Sport {
  BADMINTON
  PICKLEBALL
  TENNIS
}

enum VenueStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CourtStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum PaymentMode {
  ONLINE_FULL
  AT_VENUE
}

enum BookingType {
  SINGLE
  RECURRING
}

enum BookingSource {
  ONLINE
  COUNTER
  PHONE
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum ItemStatus {
  HELD
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  VNPAY
  MOMO
  STRIPE
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum VoucherType {
  PERCENT
  FIXED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  PAYMENT_FAILED
  PROMOTION
  SYSTEM
}

enum CoachStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum CoachVenueStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum CoachBookingStatus {
  HELD
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PartnerMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum OfferStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  EXPIRED
}

enum OfferSponsor {
  PARTNER
  VENUE
  SYSTEM
}

enum OfferUsageState {
  RESERVED
  CONSUMED
  RELEASED
}

enum PriceLineType {
  COURT
  COACH
  DISCOUNT
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  DISPUTED
}

// ───────────── Auth.js (Prisma adapter) ─────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Dùng cho đặt lại mật khẩu: identifier = email, token lưu dạng băm
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────── Người dùng ─────────────
model User {
  id            String     @id @default(cuid())
  name          String
  email         String?    @unique
  emailVerified DateTime?
  phone         String?    @unique // dạng 0xxxxxxxxx
  passwordHash  String?
  image         String?
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  loyaltyPoints Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  ownedVenues   Venue[]            @relation("VenueOwner")
  staffOf       VenueStaff[]
  bookings      Booking[]
  reviews        Review[]
  favorites      Favorite[]
  notifications  Notification[]
  pushSubs       PushSubscription[]
  groupShares    GroupShare[]
  coachProfile   CoachProfile?
  partnerMembers PartnerMember[]
}

// ───────────── Cơ sở / Sân / Giá ─────────────
model Venue {
  id                String      @id @default(cuid())
  slug              String      @unique
  name              String
  sport             Sport       @default(BADMINTON)
  description       String?
  address           String
  ward              String?
  district          String
  province          String      @default("Hà Nội")
  lat               Float
  lng               Float
  phone             String
  logoUrl           String?
  coverUrl          String?
  images            String[]
  amenities         String[] // PARKING, SHOWER, WIFI, CANTEEN, RACKET_RENTAL, SHUTTLE_SALE, AIRCON, LOCKER
  openMin           Int         @default(300) // 05:00
  closeMin          Int         @default(1320) // 22:00
  slotMinutes       Int         @default(30)
  minBookingMin     Int         @default(60)
  maxBookingMin     Int         @default(240)
  advanceDays       Int         @default(30)
  cancelBeforeHours Int         @default(4)
  paymentMode       PaymentMode @default(ONLINE_FULL)
  status            VenueStatus @default(PENDING)
  priceFrom         Int         @default(0) // denormalized: giá vãng lai thấp nhất / giờ
  ratingAvg         Float       @default(0)
  ratingCount       Int         @default(0)
  ownerId           String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  owner     User          @relation("VenueOwner", fields: [ownerId], references: [id])
  staff     VenueStaff[]
  courts    Court[]
  pricing             PricingRule[]
  bookings            Booking[]
  reviews             Review[]
  favorites           Favorite[]
  vouchers            Voucher[]
  coachVenues         CoachVenue[]
  coachAvailabilities CoachAvailability[]
  weeklySchedules     VenueWeeklySchedule[]
  dateExceptions      VenueDateException[]
  cancellationPolicies CancellationPolicy[]
  invoices            InternalInvoice[]

  @@index([status, district])
  @@index([lat, lng])
}

model VenueStaff {
  userId  String
  venueId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue   Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
}

model Court {
  id        String      @id @default(cuid())
  venueId   String
  name      String // "Sân 1"
  sortOrder Int         @default(0)
  surface   String?
  status    CourtStatus @default(ACTIVE)

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items        BookingItem[]
  blocks       CourtBlock[]
  pricingRules PricingRule[]
  sessions     CourtSession[]

  @@unique([venueId, name])
  @@index([venueId, sortOrder])
}

model PricingRule {
  id          String  @id @default(cuid())
  venueId     String
  label       String?
  daysOfWeek  Int[] // 1=Thứ 2 ... 7=Chủ nhật
  startMin    Int
  endMin      Int
  walkInPrice Int // VND / giờ — Vãng lai
  fixedPrice  Int // VND / giờ — Cố định
  courtId     String? // null: áp dụng toàn cơ sở; có giá trị: ưu tiên cho sân cụ thể
  court       Court?  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  venue       Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([courtId])
}

model CourtBlock {
  id          String   @id @default(cuid())
  courtId     String
  date        DateTime @db.Date
  startMin    Int
  endMin      Int
  reason      String?
  createdById String
  createdAt   DateTime @default(now())
  court       Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, date])
}

// ───────────── Đặt sân ─────────────
model Booking {
  id            String        @id @default(cuid())
  requestId     String?       @unique // chống tạo đơn lặp khi trình duyệt thử lại
  code          String        @unique // ví dụ: SB-241002-7K2F
  userId        String? // null = khách đặt hộ tại quầy
  venueId       String
  type          BookingType   @default(SINGLE)
  source        BookingSource @default(ONLINE)
  status        BookingStatus @default(PENDING_PAYMENT)
  customerName  String
  customerPhone String
  note          String?
  subtotal      Int
  discount      Int           @default(0)
  total         Int
  voucherId     String?
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentProvider? // null: legacy venue policy; new orders default to BANK_TRANSFER
  expiresAt     DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  recurringId   String? // Phase 2
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User?         @relation(fields: [userId], references: [id])
  venue    Venue         @relation(fields: [venueId], references: [id])
  voucher  Voucher?      @relation(fields: [voucherId], references: [id])
  items       BookingItem[]
  payments    Payment[]
  review      Review?
  group       BookingGroup?
  priceLines  BookingPriceLine[]
  offerUsages OfferUsage[]
  voucherUsages VoucherUsage[]
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  cancellationSnapshot Json?
  invoices             InternalInvoice[]
  sessions             CourtSession[]
  refundRequests       RefundRequest[]
  tickets              Ticket[]

  @@index([userId, createdAt])
  @@index([venueId, status])
  @@index([status, expiresAt])
}

model BookingItem {
  id        String     @id @default(cuid())
  bookingId String
  courtId   String
  date      DateTime   @db.Date
  startMin  Int
  endMin    Int
  price     Int
  status    ItemStatus @default(HELD)

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  court        Court         @relation(fields: [courtId], references: [id])
  coachBooking CoachBooking?
  session      CourtSession?
  tickets      Ticket[]

  @@index([courtId, date])
  @@index([bookingId])
}

model Payment {
  id            String          @id @default(cuid())
  bookingId     String
  provider      PaymentProvider
  amount        Int
  status        PaymentStatus   @default(PENDING)
  txnRef        String          @unique // mã giao dịch gửi cổng, duy nhất mỗi lần thử
  providerTxnNo String?
  paidAt        DateTime?
  rawPayload    Json?
  createdAt     DateTime        @default(now())
  booking            Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  groupShares        GroupShare[]
  groupRefund        GroupRefund?
  refundRequests     RefundRequest[]
  refundTransactions RefundTransaction[]

  @@index([bookingId])
}

// Group payments use fixed shares. A payment can settle several shares on behalf of members.
model BookingGroup {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  inviteToken String   @unique
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id])
  shares      GroupShare[]
  intents     GroupPaymentIntent[]
}

model GroupShare {
  id             String   @id @default(cuid())
  groupId        String
  position       Int
  label          String
  amount         Int
  userId         String?
  cashRequested  Boolean  @default(false)
  cashApprovedAt DateTime?
  paymentId      String?
  currentIntentId String?
  ticketNonce    String   @unique
  checkedInAt    DateTime?
  checkedInBy    String?
  group          BookingGroup @relation(fields: [groupId], references: [id])
  user           User?    @relation(fields: [userId], references: [id])
  payment        Payment? @relation(fields: [paymentId], references: [id])
  currentIntent  GroupPaymentIntent? @relation(fields: [currentIntentId], references: [id])

  @@unique([groupId, position])
  @@unique([groupId, userId])
  @@index([userId])
  @@index([paymentId])
  @@index([currentIntentId])
}

model GroupPaymentIntent {
  id          String   @id @default(cuid())
  groupId     String
  code        String   @unique
  payerId     String
  amount      Int
  shareIds    String[]
  bank        Json
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  group       BookingGroup @relation(fields: [groupId], references: [id])
  currentShares GroupShare[]

  @@index([groupId, status])
}

model GroupRefund {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  amount      Int
  reason      String
  status      String   @default("PENDING")
  reference   String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id])

  @@index([status, createdAt])
}

// Lưu cả giao dịch không khớp đơn để chủ sân đối soát; không xóa khi xóa booking.
model SepayReceipt {
  transactionId String   @id
  fingerprint   String
  bookingCode   String?
  result        String
  payload       Json
  receivedAt    DateTime @default(now())

  @@index([result, receivedAt])
}

// Nhật ký quản trị: chỉ server được ghi, không có API sửa/xóa.
model AdminAudit {
  id         String   @id @default(cuid())
  actorId    String
  actorName  String
  action     String
  entityId   String
  reason     String
  details    Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityId, createdAt])
}

// ───────────── Khuyến mãi, đánh giá, yêu thích, thông báo ─────────────
model Voucher {
  id          String      @id @default(cuid())
  code        String      @unique
  type        VoucherType
  value       Int // PERCENT: 1-100, FIXED: VND
  maxDiscount Int?
  minAmount   Int         @default(0)
  venueId     String? // null = toàn hệ thống
  validFrom   DateTime
  validTo     DateTime
  usageLimit  Int?
  usedCount   Int         @default(0)
  isActive    Boolean     @default(true)
  venue        Venue?        @relation(fields: [venueId], references: [id])
  bookings     Booking[]
  partnerOffer PartnerOffer?
  usages       VoucherUsage[]
}

model VoucherUsage {
  id        String   @id @default(cuid())
  voucherId String
  bookingId String
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([voucherId, bookingId])
  @@index([bookingId])
  @@index([voucherId])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  userId    String
  venueId   String
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, createdAt])
}

model Favorite {
  userId    String
  venueId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  endpoint String @unique
  p256dh   String
  auth     String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────── Huấn luyện viên (Coach) ─────────────
model CoachProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  bio             String?
  specialties     String[]     // Ví dụ: ["Cơ bản", "Nâng cao", "Đơn nam", "Đôi nam nữ"]
  experienceYears Int          @default(0)
  hourlyRate      Int          // VND / giờ, tối thiểu >= 0
  status          CoachStatus  @default(PENDING)
  reviewReason    String?      // Lý do từ chối hoặc tạm ngưng của Admin
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificates   CoachCertificate[]
  venues         CoachVenue[]
  availabilities CoachAvailability[]
  bookings       CoachBooking[]
  settlements    CoachSettlement[]

  @@index([status, hourlyRate])
}

model CoachCertificate {
  id         String    @id @default(cuid())
  coachId    String
  title      String    // Tên bằng cấp / chứng chỉ
  fileKey    String    // Khóa tệp lưu trữ riêng tư (S3 / R2)
  verifiedAt DateTime?
  verifiedBy String?
  createdAt  DateTime  @default(now())

  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
}

model CoachVenue {
  id           String           @id @default(cuid())
  coachId      String
  venueId      String
  status       CoachVenueStatus @default(PENDING)
  reviewReason String?
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  venue Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([coachId, venueId])
  @@index([venueId, status])
}

model CoachAvailability {
  id        String   @id @default(cuid())
  coachId   String
  venueId   String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())

  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  venue Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([coachId, startsAt, endsAt])
  @@index([venueId, startsAt, endsAt])
}

model CoachBooking {
  id                     String             @id @default(cuid())
  coachId                String
  bookingItemId          String             @unique
  startsAt               DateTime
  endsAt                 DateTime
  fee                    Int                // Phí HLV thực tế đã chốt (VND)
  hourlyRateSnapshot     Int                // Giá giờ HLV tại thời điểm đặt
  commissionRateSnapshot Float              // Tỷ lệ hoa hồng sàn (ví dụ 0.10 cho 10%)
  commissionAmount       Int                // Số tiền hoa hồng sàn thu (VND)
  status                 CoachBookingStatus @default(HELD)
  expiresAt              DateTime?          // Đồng bộ với Booking.expiresAt
  cancelledAt            DateTime?
  cancelReason           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  coach       CoachProfile @relation(fields: [coachId], references: [id])
  bookingItem BookingItem  @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@index([coachId, startsAt, endsAt])
  @@index([status, expiresAt])
}

// ───────────── Đối tác & Ưu đãi (Partner & Offer) ─────────────
model Partner {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  logoUrl      String?
  description  String?
  contactPhone String?
  contactEmail String?
  status       PartnerStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  members PartnerMember[]
  offers  PartnerOffer[]

  @@index([status])
}

model PartnerMember {
  id        String            @id @default(cuid())
  partnerId String
  userId    String
  role      PartnerMemberRole @default(STAFF)
  createdAt DateTime          @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
  @@index([userId])
}

model PartnerOffer {
  id            String       @id @default(cuid())
  partnerId     String
  voucherId     String       @unique
  title         String
  description   String?
  sponsor       OfferSponsor @default(PARTNER)
  budget        Int          // Ngân sách tài trợ tối đa (VND)
  usedBudget    Int          @default(0)
  maxUsage      Int?         // Số lượt tối đa nếu có giới hạn
  currentUsage  Int          @default(0)
  status        OfferStatus  @default(DRAFT)
  version       Int          @default(1)
  termsSnapshot Json?        // Điều kiện áp dụng có cấu trúc (ví dụ minTotal, venueIds...)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  partner Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  voucher Voucher      @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  usages  OfferUsage[]

  @@index([partnerId, status])
}

model OfferUsage {
  id             String          @id @default(cuid())
  offerId        String
  bookingId      String
  userId         String
  discountAmount Int
  state          OfferUsageState @default(RESERVED)
  expiresAt      DateTime?       // Hết hạn giữ chỗ, đồng bộ Booking.expiresAt
  termsSnapshot  Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  offer   PartnerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([offerId, bookingId])
  @@index([userId])
  @@index([state, expiresAt])
}

// ───────────── Bóc tách tài chính & Đối soát (Settlement) ─────────────
model BookingPriceLine {
  id              String        @id @default(cuid())
  bookingId       String
  type            PriceLineType
  amount          Int           // Giá trị VND (dương cho COURT/COACH, giảm giá lưu số dương tương ứng)
  label           String        // Tiêu đề hiển thị (vd: "Tiền thuê Sân 1", "Phí HLV Nguyễn Văn A", "Ưu đãi Đối tác Yonex")
  beneficiaryId   String?       // ID người thụ hưởng (coachId hoặc venueId hoặc partnerId)
  pricingSnapshot Json?
  createdAt       DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model CoachSettlement {
  id             String           @id @default(cuid())
  coachId        String
  periodStart    DateTime
  periodEnd      DateTime
  grossCollected Int              // Tổng tiền thực thu từ khách (VND)
  refunds        Int              @default(0) // Khoản hoàn lại khách nếu có (VND)
  commission     Int              // Tiền hoa hồng sàn khấu trừ (VND)
  netAmount      Int              // Số tiền chi trả cho HLV = grossCollected - refunds - commission
  status         SettlementStatus @default(PENDING)
  reference      String?          // Mã chứng từ ngân hàng / phiếu chi
  note           String?
  createdById    String           // Admin tạo kỳ đối soát
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  coach CoachProfile @relation(fields: [coachId], references: [id])

  @@index([coachId, status])
  @@index([periodStart, periodEnd])
}

// ───────────── Lịch hoạt động chi tiết & Ngoại lệ ─────────────
model VenueWeeklySchedule {
  id        String   @id @default(cuid())
  venueId   String
  dayOfWeek Int      // 1=Thứ 2 ... 7=Chủ nhật
  openMin   Int      // phút từ 00:00 (vd 300 = 05:00)
  closeMin  Int      // phút từ 00:00 (vd 1320 = 22:00)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, dayOfWeek])
  @@index([venueId])
}

model VenueDateException {
  id        String   @id @default(cuid())
  venueId   String
  date      String   // YYYY-MM-DD
  isClosed  Boolean  @default(false)
  openMin   Int?     // giờ mở đặc biệt
  closeMin  Int?     // giờ đóng đặc biệt
  reason    String?  // Nghỉ lễ, giải đấu, sửa chữa...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, date])
  @@index([venueId, date])
}

// ───────────── Chính sách hủy có phiên bản ─────────────
model CancellationPolicy {
  id                   String   @id @default(cuid())
  venueId              String
  name                 String   // Tên chính sách
  version              Int      @default(1)
  isDefault            Boolean  @default(false)
  freeCancelHours      Int      @default(24) // Trước 24h hoàn 100%
  lateCancelHours      Int      @default(4)  // Trước 4h hoàn partialRefundPercent%
  partialRefundPercent Int      @default(50) // % hoàn khi hủy muộn
  nonRefundableHours   Int      @default(4)  // Dưới 4h không hoàn
  allowCoachRefund     Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([venueId])
}

// ───────────── Hóa đơn / Chứng từ nội bộ ─────────────
model InternalInvoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique // INV-YYYYMMDD-XXXX
  bookingId     String
  venueId       String
  issuedById    String?  // ID người phát hành hoặc SYSTEM
  issuedAt      DateTime @default(now())
  subtotal      Int
  discount      Int      @default(0)
  totalAmount   Int
  paidAmount    Int
  customerName  String
  customerPhone String
  customerEmail String?
  venueName     String
  venueAddress  String
  snapshot      Json     // Snapshot bất biến chi tiết sân, giờ, thanh toán, HLV, voucher
  status        String   @default("ISSUED") // ISSUED, CANCELLED, ADJUSTED
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([venueId])
  @@index([issuedAt])
}

// ───────────── Phiên sử dụng sân & Phụ thu ─────────────
model CourtSession {
  id            String          @id @default(cuid())
  bookingItemId String          @unique
  bookingId     String
  courtId       String
  operatorId    String?         // Nhân viên check-in
  checkInAt     DateTime        @default(now())
  checkOutAt    DateTime?       // Trả sân thực tế
  status        String          @default("ACTIVE") // ACTIVE, COMPLETED, NO_SHOW
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  bookingItem BookingItem      @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  court       Court            @relation(fields: [courtId], references: [id], onDelete: Cascade)
  surcharges  CourtSurcharge[]

  @@index([bookingId])
  @@index([courtId])
  @@index([status])
}

model CourtSurcharge {
  requestId     String?      @unique // Chống gửi lại thao tác thu phụ phí
  id            String       @id @default(cuid())
  sessionId     String
  bookingId     String
  venueId       String
  createdById   String       // Nhân viên phụ trách
  type          String       // OVERTIME, SERVICE, DAMAGE, OTHER
  amount        Int
  reason        String
  status        String       @default("UNPAID") // UNPAID, PAID, WAIVED
  paymentMethod String?      // CASH, BANK_TRANSFER, QR
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  session CourtSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([bookingId])
  @@index([venueId])
}

// ───────────── Quy trình hoàn tiền có kiểm soát ─────────────
model RefundRequest {
  id                String              @id @default(cuid())
  bookingId         String
  paymentId         String?
  requestedById     String              // Người yêu cầu hoặc SYSTEM
  approvedById      String?             // Nhân viên duyệt
  amount            Int
  type              String              // FULL_CANCELLATION, PARTIAL_CANCELLATION, COACH_CANCELLATION, OVERPAYMENT, DISPUTE
  reason            String
  status            String              @default("REQUESTED") // REQUESTED, PROCESSING, COMPLETED, REJECTED, FAILED
  bankAccountNumber String?
  bankAccountName   String?
  bankName          String?
  rejectedReason    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  booking      Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment      Payment?            @relation(fields: [paymentId], references: [id])
  transactions RefundTransaction[]

  @@index([bookingId])
  @@index([status])
}

model RefundTransaction {
  id            String        @id @default(cuid())
  requestId     String
  paymentId     String?
  amount        Int
  method        String        @default("MANUAL_BANK_TRANSFER") // MANUAL_BANK_TRANSFER, SEPAY_MANUAL, CASH
  bankRef       String?       // Mã tham chiếu giao dịch ngân hàng
  proofImage    String?       // Ảnh ủy nhiệm chi hoặc biên lai
  processedById String        // Nhân viên hoàn tất
  processedAt   DateTime      @default(now())
  status        String        @default("COMPLETED") // COMPLETED, FAILED
  notes         String?
  createdAt     DateTime      @default(now())

  request RefundRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  payment Payment?      @relation(fields: [paymentId], references: [id])

  @@index([requestId])
}

// ───────────── Vé điện tử cho đơn đặt sân ─────────────
model Ticket {
  id            String       @id @default(cuid())
  ticketCode    String       @unique // TKT-YYYYMMDD-XXXX
  ticketNonce   String       @unique
  bookingId     String
  bookingItemId String?
  groupShareId  String?      // Nếu gắn theo suất nhóm
  holderName    String
  holderPhone   String
  status        String       @default("UNUSED") // UNUSED, CHECKED_IN, EXPIRED, CANCELLED
  validFrom     DateTime
  validTo       DateTime
  checkedInAt   DateTime?
  checkedInById String?      // Nhân viên quét vé
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem BookingItem? @relation(fields: [bookingItemId], references: [id])

  @@index([bookingId])
  @@index([status])
  @@index([validFrom, validTo])
}


